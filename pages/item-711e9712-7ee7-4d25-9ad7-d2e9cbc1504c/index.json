rt a video</li>\n  </ol>\n\n\n\n\n  <video-player source=\"https://www.youtube.com/watch?v=zmext_0e4xQ\" slot=\"col-2\" accent-color=\"grey\" crossorigin=\"anonymous\" sticky-corner=\"none\" resource=\"#38d3b116-7d67-ddb6-77ec-7895005fb4f1\" prefix=\"oer:http://oerschema.org/ schema:http://schema.org/ dc:http://purl.org/dc/terms/ foaf:http://xmlns.com/foaf/0.1/ cc:http://creativecommons.org/ns# bib:http://bib.schema.org \" element-visible source-type=\"youtube\" lang=\"en\" source-data=\"[{&quot;src&quot;:&quot;https://www.youtube.com/embed/zmext_0e4xQ&quot;,&quot;type&quot;:&quot;&quot;}]\" audio-description-source=\"\"></video-player>\n\n\n\n\n</grid-plate>\n<h2 id=\"h2--798190757\">This looks fun, let's go!</h2>\n<meme-maker image-url=\"/files/brain-galaxy.jpg\" top-text=\"You, while using HAX\" bottom-text=\"...probably\">\n    <div>You, while using HAX</div>\n      <img src=\"/files/brain-galaxy.jpg\" alt=\"\" preload=\"lazy\" aria-describedby=\"\"/>\n    <div>...probably</div></meme-maker>\n<h2 id=\"h2--1479273868\">Get involved with HAX</h2>\n<p>\n  <rpg-character accent-color=\"orange\" seed=\"goqyast191\" accessories=\"1\" height=\"142\" width=\"113\" base=\"0\" face=\"4\" face-item=\"9\" hair=\"0\" pants=\"0\" shirt=\"7\" skin=\"3\" hat-color=\"9\" hat=\"none\" leg=\"R\" speed=\"500\"></rpg-character>\n\n\n\n\n  <rpg-character accent-color=\"orange\" seed=\"j432cn57o7\" accessories=\"1\" height=\"142\" width=\"113\" base=\"0\" face=\"0\" face-item=\"9\" hair=\"4\" pants=\"1\" shirt=\"0\" skin=\"0\" hat-color=\"9\" hat=\"none\" leg=\"R\" speed=\"500\"></rpg-character>\n\n\n\n\n  <rpg-character seed=\"btopro\" accent-color=\"orange\" accessories=\"7\" height=\"142\" width=\"113\" base=\"0\" face=\"2\" face-item=\"1\" hair=\"5\" pants=\"5\" shirt=\"5\" skin=\"0\" hat-color=\"1\" hat=\"none\" leg=\"L\" speed=\"500\"></rpg-character>\n\n\n\n\n  <rpg-character seed=\"haxtheweb\" accent-color=\"orange\" accessories=\"9\" height=\"142\" width=\"113\" base=\"0\" fa