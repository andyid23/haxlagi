  "content": "\n<p>Welcome to your new HAX site! Click edit on the top bar to get started</p>\n<p>\n  <!--     STEP 1: Login     -->\n</p>\n<div class=\"step\">\n   <h2><span class=\"step-num\">1</span> Login / Registrasi</h2>\n\n\n\n\n\n  <quiz-user-auth id=\"auth\" apps-script-url=\"https://script.google.com/macros/s/AKfycbzwwv-XI1EC3puQdS8rsTjOobw8rmNXOqOkklInfFB5xBdQJ83po2lq-gxRtDuiE5LG/exec\" auto-login _student-id=\"STD-65108053\"></quiz-user-auth>\n\n\n\n\n</div>\n<p></p>\n<h2 id=\"h2-991900209\">What can I do?</h2>\n<p></p>\n<p>\n  <!--     STEP 2: Tugas + Forum     -->\n</p>\n<div class=\"step\">\n   <h2><span class=\"step-num\">2</span> Tugas Mandiri &#38; Forum Diskusi</h2>\n\n\n\n\n\n  <p style=\"font-size:13px;color:#666;\">Tugas tersimpan ke <code>Tugas Log</code> sheet. Forum CRUD via <code>Forum Log</code> sheet\n    (nested replies, like, sort).</p>\n\n\n\n\n  <assignment-forum hide-delete id=\"af1\" assignment-title=\"Refleksi Energi Terbarukan\" assignment-instruction=\"Tuliskan refleksi: kontribusi apa yang bisa Anda lakukan untuk mendukung energi terbarukan di lingkungan rumah? Sertakan link Google Drive/Doc jika ada file pendukung.\" forum-topik=\"Diskusi: Potensi Energi Terbarukan\" apps-script-url=\"https://script.google.com/macros/s/AKfycbzwwv-XI1EC3puQdS8rsTjOobw8rmNXOqOkklInfFB5xBdQJ83po2lq-gxRtDuiE5LG/exec\" forum-api-url=\"https://script.google.com/macros/s/AKfycby1Ltq-eg599WR2W4FPY6r_GDNs_N5gB29Pvdf3NisKvWlymh3xl6ajk0kU-IkxyAT_Nw/exec\" sheet-name=\"Pertemuan 1\" view-mode=\"lecturer\" forum-topic=\"Forum Diskusi\" _assignment-submitted student-id=\"STD-65108053\" student-name=\"Andy Yulianto\" student-nis=\"234\" student-absen=\"2\" student-kelas=\"XI-1\" _sort-mode=\"best\" _assignment-text=\"gggfd\"></assignment-forum>\n\n\n\n\n</div>\n<div class=\"step\">\n   <h2><span class=\"step-num\">3</span> Kuis Formatif</h2>\n\n\n\n\n\n  <explode-quiz hide-answers hide-confetti id=\"quiz1\" sheet-name=\"Pertemuan 1\" quiz-category=\"formatif\